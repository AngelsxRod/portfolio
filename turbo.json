{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["PORT"],
  "globalPassThroughEnv": ["API_URL", "DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/dist/**"
      ],
      "env": ["API_URL"]
    },
    "test": {},
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
