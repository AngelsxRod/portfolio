    "resend": "^6.34.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.9",
    "@nestjs/testing": "12.1.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
